<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off">

  <targets>
    <!-- File Target with full logs -->
    <target xsi:type="File" name="fileTarget"
            fileName="logs/test-${shortdate}.log"
            layout="${longdate} ${level:uppercase=true} ${logger} ${message} ${exception:format=tostring}" />
    
    <!-- Console Target with filtering -->
    <target xsi:type="Console" name="consoleTarget"
            layout="${time} [${level:uppercase=true}] ${logger:shortName=true}: ${message} ${exception:format=tostring}" />
  </targets>

  <rules>
    <!-- Filter verbose Aquality logs from console -->
    <logger name="*" minlevel="Info" writeTo="consoleTarget">
      <filters defaultAction="Log">
        <!-- Filter Aquality's verbose element interaction logs -->
        <when condition="contains('${message}',':: Waiting for element')" action="Ignore" />
        <when condition="contains('${message}',':: Getting text from element')" action="Ignore" />
        <when condition="contains('${message}',':: Element''s text:')" action="Ignore" />
        <when condition="contains('${message}',':: Clicking')" action="Ignore" />
        <when condition="contains('${message}',':: Clearing')" action="Ignore" />
        <when condition="contains('${message}',':: Typing')" action="Ignore" />
        <when condition="contains('${message}',':: Sending keys')" action="Ignore" />
        <when condition="contains('${message}','Getting current URL')" action="Ignore" />
        <when condition="contains('${message}','Current URL:')" action="Ignore" />
        <when condition="contains('${message}','Browser') and contains('${message}','ready')" action="Ignore" />
        <when condition="contains('${message}','Maximizing browser')" action="Ignore" />
        <when condition="contains('${message}','Navigate to URL')" action="Ignore" />
        <when condition="contains('${message}','Waiting for page to load')" action="Ignore" />
        <when condition="contains('${message}','Cannot find localized message')" action="Ignore" />
        <when condition="contains('${message}','No elements with locator')" action="Ignore" />
        <when condition="contains('${message}','Elements were found by locator')" action="Ignore" />
        <when condition="contains('${message}','Element has not become displayed')" action="Ignore" />
      </filters>
    </logger>
    
    <!-- All logs go to file (for debugging) -->
    <logger name="*" minlevel="Info" writeTo="fileTarget" />
    
    <!-- Suppress verbose system logs -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.*" maxlevel="Info" final="true" />
  </rules>
</nlog>