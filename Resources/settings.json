{
  "browserName": "chrome",
  "isRemote": false,
  "remoteConnectionUrl": "",
  "isElementHighlightEnabled": false,
  "highlightOnFailure": true,
  "pageLoadTimeout": 60,
  "timeouts": {
    "timeoutImplicit": 0,
    "timeoutCondition": 15,
    "timeoutCommand": 60,
    "timeoutScript": 10,
    "timeoutPageLoad": 60,
    "timeoutPollingInterval": 300
  },
  "retry": {
    "number": 5,
    "pollingInterval": 0.3
  },
  "logger": {
    "language": "en",
    "logPageSource": false
  },
  "elementCache": {
    "isEnabled": true
  },
  "credentials": {
    "email": "",
    "password": ""
  },
  "browserSettings": {
    "chrome": {
      "webDriverVersion": "Latest",
      "systemArchitecture": "Auto",
      "startArguments": [
        "--start-maximized",
        "--start-fullscreen",
        "--disable-notifications",
        "--no-sandbox",
        "--disable-dev-shm-usage",
        "--disable-popup-blocking",
        "--disable-infobars",
        "--disable-extensions",
        "--window-size=1920,1080",
        "--window-position=0,0",
        "--log-level=3"
      ],
      "options": {
        "intl.accept_languages": "en",
        "profile.default_content_settings.popups": 0
      },
      "excludedArguments": [

      ],
      "mobileEmulation": {

      },
      "userProfilePreferences": {

      },
      "extensions": [

      ]
    }
  }
}